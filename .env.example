# ---- Storage -------------------------------------------------------------
# All projects, renders and exports live here. Originals are copied in and never modified.
AUDIOLAYER_WORKSPACE=~/AudioLayer/workspace
# Model weights cache (PANNs, Whisper). Demucs uses the torch hub cache.
AUDIOLAYER_MODEL_DIR=~/.cache/audiolayer
AUDIOLAYER_ALLOW_MODEL_DOWNLOAD=true

# ---- Models --------------------------------------------------------------
AUDIOLAYER_ENGINE=auto              # auto | torch | onnx (torch-free cloud engine)
AUDIOLAYER_DEVICE=auto              # auto | cpu | cuda | mps
AUDIOLAYER_CLASSIFIER=auto          # auto | panns | heuristic
AUDIOLAYER_SEPARATOR=auto           # auto | demucs | none
AUDIOLAYER_DEMUCS_MODEL=htdemucs    # htdemucs | htdemucs_ft (better, ~4x slower)
AUDIOLAYER_ASR=auto                 # auto | faster-whisper | none
AUDIOLAYER_WHISPER_MODEL=base       # tiny | base | small | medium | large-v3

# ---- Limits / performance --------------------------------------------------
AUDIOLAYER_MAX_UPLOAD_MB=2048
AUDIOLAYER_MAX_DURATION_S=1800
AUDIOLAYER_WORKERS=1                # parallel jobs (separation saturates CPU/GPU)
AUDIOLAYER_CHUNK_SECONDS=30         # processing chunk (memory bound + cancel granularity)

# ---- Local MCP (Claude Desktop) ----------------------------------------------
# Folders the MCP server may read media from (os.pathsep-separated). Nothing else is readable.
AUDIOLAYER_INPUT_DIRS=~/Videos

# ---- Remote deployment (API + remote MCP) -------------------------------------
# name:token pairs. When set, every API/MCP request needs "Authorization: Bearer <token>".
# AUDIOLAYER_AUTH_TOKENS=alice:change-me-long-random,bob:another-long-random
# AUDIOLAYER_PUBLIC_BASE_URL=https://audiolayer.example.com
# AUDIOLAYER_ALLOWED_HOSTS=audiolayer.example.com
AUDIOLAYER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
